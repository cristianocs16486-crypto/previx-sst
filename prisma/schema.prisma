generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Funcionario {
  id        String   @id @default(cuid())
  nome      String
  cpf       String?
  cargo     String?
  funcao    String?
  pin       String?
  setor     String?
  empresa   String?
  admissao  String?
  createdAt DateTime @default(now())
}

model Epi {
  id         String   @id @default(cuid())
  nome       String
  descricao  String?
  quantidade Int      @default(0)
  createdAt  DateTime @default(now())
}

model Extintor {
  id            String   @id @default(cuid())
  tipo          String
  numero        String?
  capacidade    String?
  local         String?
  localizacao   String?
  status        String?
  ultimaRecarga String?
  vencimento    String?
  validade      String?
  createdAt     DateTime @default(now())
}

model Inspecao {
  id        String   @id @default(cuid())
  titulo    String
  local     String?
  data      String?
  status    String?
  createdAt DateTime @default(now())
}

model Documento {
  id         String   @id @default(cuid())
  nome       String?
  titulo     String?
  empresa    String?
  tipo       String?
  arquivo    String?
  vencimento String?
  createdAt  DateTime @default(now())
}model Exame {
  id          String   @id @default(cuid())
  funcionario String
  tipo        String
  data        String?
  resultado   String?
  createdAt   DateTime @default(now())
}

model Empresa {
  id        String   @id @default(cuid())
  nome      String
  cnpj      String?
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
}